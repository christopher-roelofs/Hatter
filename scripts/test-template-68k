#!/usr/bin/env python3
"""Build a 68k example from its sources, install it on the PIC, open its scene.

This is the end-to-end check for the 68k writer. Nothing is copied from the
package ObjectMaker produced: the cluster is emitted from the example's
definition files and the SDK's, transferred over PC Link the way a
developer's would be, and driven through the guest's own UI until its scene
is on screen. The same walk is run against the package ObjectMaker built, and
the two are required to put up the same pixels.

  scripts/test-template-68k [outdir] [--example NAME ...] [--skip-install]

With no --example it checks Template, which also has a recorded golden so the
test can tell "both broke" from "they agree". STATE, INSNS and MCAP mean what
they do in install-package-68k.
"""
import argparse
import hashlib
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
os.chdir(ROOT)
sys.path.insert(0, str(ROOT / 'experiments' / 'objectmaker'))

EXAMPLES = ROOT / 'software/68k/extracted/cookbook/Cookbook Examples'
PACKAGES = ROOT / 'software/68k/extracted/installable/cookbook'

# The examples that build without a Code object. Which definition files each
# one is built from, and in what order, is no longer written down here: the
# builder reads it out of the example's own project file.
SOURCES = {name: None for name in (
    'Template', 'TemplateWithButtons', 'StackTemplate',
    'StackTemplateWithIndex', 'Snake')}

# The Storeroom, the Hallway three screens along, and the door itself.
WALK = ['--tap', '1000000,1000000,420,12',
        '--tap', '60000000,1000000,455,258',
        '--tap', '120000000,1000000,455,258',
        '--tap', '180000000,1000000,455,258',
        '--tap', '240000000,1000000,230,145']

# The title and the application area, which leaves out the clock and date.
GOLDEN = {'Template':
          '9f7c62a87f9acc658b9c04b080e2a372e4b3ce7bba5fc2154a70d1f29d64a015'}

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('outdir', nargs='?', default='out/pic-68k-template')
parser.add_argument('--example', action='append', choices=sorted(SOURCES))
parser.add_argument('--skip-install', action='store_true')
args = parser.parse_args()
out = Path(args.outdir)
out.mkdir(parents=True, exist_ok=True)
mcap = os.environ.get('MCAP', 'build/mcap')
rom = 'roms/Sony PIC 2000/PIC-2000.rom'


def crop(tag):
    magic, size, maximum, pixels = (out / f'{tag}.pgm').read_bytes().split(b'\n', 3)
    if magic != b'P5' or size != b'480 320' or len(pixels) != 480 * 320:
        raise RuntimeError('unexpected PIC framebuffer format')
    title = b''.join(pixels[y * 480:y * 480 + 110] for y in range(0, 20))
    body = b''.join(pixels[y * 480:y * 480 + 480] for y in range(24, 270))
    return hashlib.sha256(title + body).hexdigest()


def open_it(tag):
    with (out / f'{tag}-scene.log').open('w') as log:
        subprocess.run([mcap, '--rom', rom, '--device', 'pic2000', '--headless',
                        '--no-host-battery', '--temporary',
                        '--load-state', str(out / f'{tag}.state'),
                        '-n', '320000000', '--cpu-engine', 'interpreter',
                        '--dump-fb', str(out / f'{tag}-scene.pgm'), *WALK],
                       stdout=log, stderr=subprocess.STDOUT, check=True)
    return crop(f'{tag}-scene')


for name in args.example or ['Template']:
    built = out / f'{name}-built.pkg'
    if not args.skip_install:
        from build_example import build_example
        package, missing = build_example(EXAMPLES / name, report=True,
                                         sources=SOURCES[name])
        print(f'{name}: built {len(package)} bytes')
        if missing:
            raise RuntimeError(f'{name}: no layout for '
                               f'{sorted(f for v in missing.values() for f in v)}')
        built.write_bytes(package)
        for tag, path in ((f'{name}-built', built),
                          (f'{name}-stock', PACKAGES / f'{name}.pkg')):
            # A transfer takes time in proportion to what it is sending, and
            # Snake is thirty kilobytes of sound where Template is two, so
            # the budget follows the package rather than being one number.
            budget = max(2_000_000_000, path.stat().st_size * 200_000)
            subprocess.run(['scripts/install-package-68k', str(path), str(out),
                            tag, '--cpu-engine', 'interpreter'], check=True,
                           env={**os.environ,
                                'INSNS': os.environ.get('INSNS', str(budget))})
    ours, theirs = open_it(f'{name}-built'), open_it(f'{name}-stock')
    if name in GOLDEN and theirs != GOLDEN[name]:
        raise RuntimeError(f'{name}: the package ObjectMaker built no longer '
                           f'opens to the golden scene; see {out}/{name}-stock-scene.pgm')
    if ours != theirs:
        raise RuntimeError(f'{name}: the built package opens to a different '
                           f'scene; compare {out}/{name}-built-scene.pgm with '
                           f'{out}/{name}-stock-scene.pgm')
    print(f'PASS: {name} built from source opens to the same scene as '
          f"ObjectMaker's")
