read "MagicCap.cdef";
define class SokobanBoard;
    inherits from Box;
    field level: Signed, getter, setter;
    field player: Signed, getter, setter;
    field boxA: Signed, getter, setter;
    field boxB: Signed, getter, setter;
    field moves: Signed, getter, setter;
    field pushes: Signed, getter, setter;
    field undoPlayer: Signed, getter, setter;
    field undoA: Signed, getter, setter;
    field undoB: Signed, getter, setter;
    field undoMoves: Signed, getter, setter;
    field undoPushes: Signed, getter, setter;
    field canUndo: Signed, getter, setter;
    attribute Level: Signed;
    attribute Player: Signed;
    attribute BoxA: Signed;
    attribute BoxB: Signed;
    attribute Moves: Signed;
    attribute Pushes: Signed;
    attribute UndoPlayer: Signed;
    attribute UndoA: Signed;
    attribute UndoB: Signed;
    attribute UndoMoves: Signed;
    attribute UndoPushes: Signed;
    attribute CanUndo: Signed;
    operation Restart();
    operation UndoMove();
    operation NextPuzzle();
    overrides Draw;
    overrides Tap;
end class;
define interface SokobanInterface "Hatter/SokobanInterface1";
    class SokobanBoard;
end interface;
